{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gearnest-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "1d46eaac6b7c875ec2ab4a90a5e0a2fe",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.gearnest.sraboni.dev", "custom_domain": true }],
  "vars": {
    "MONGODB_DB": "gearnest",
    "CURRENCY": "USD",
    "CLIENT_ORIGIN": "https://gearnest.sraboni.dev",
    "AUTH_ISSUER": "https://gearnest.sraboni.dev",
    "JWT_AUDIENCE": "https://api.gearnest.sraboni.dev",
    "EMAIL_FROM": "GearNest <notifications@sraboni.dev>"
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
