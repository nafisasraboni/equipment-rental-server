{
  "name": "gearnest-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:integration": "tsx scripts/integration.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "jose": "6.2.18",
    "mongodb": "6.21.0",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.165.0"
  }
}
